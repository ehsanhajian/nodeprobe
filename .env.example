# Public site
DAPPILITY_DOMAIN=dapptility.com
DAPPILITY_REPORT_BASE_URL=https://dapptility.com

# Let's Encrypt contact (required for certificate expiry notices)
ACME_EMAIL=security@dapptility.com

# Admin HTTP Basic auth (user is always "admin")
DAPPILITY_ADMIN_PASSWORD=change-me-to-a-long-random-password

# App secrets
DAPPILITY_SECRET_KEY=change-me-to-a-long-random-secret

# Optional
DAPPILITY_RAW_RETENTION_DAYS=30

# Optional ChainList RPC inventory sync (off by default for personal use)
DAPPILITY_DISCOVERY_ENABLED=false
DAPPILITY_DISCOVERY_HOUR_UTC=6
DAPPILITY_DISCOVERY_AUTO_PROMOTE_SCORE=70
DAPPILITY_CHAINLIST_URL=https://chainlist.org/rpcs.json
